# Refer to .env for the canonical list. Never commit real secrets.

APP_NAME=Finance Manager

# development | production
ENVIRONMENT=development

# SQLite — set by docker-compose.yml in production (sqlite:///./data/finance.db).
DATABASE_URL=sqlite:///./data/finance.db

# Claude AI (optional) — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# CORS — comma-separated list of allowed origins.
# Production: https://finance.pilotmessenger.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Authentication — single-user gate. If APP_PASSWORD is empty, auth is BYPASSED
# (the app runs open). In production this MUST be a strong, long value.
APP_USERNAME=Admin
APP_PASSWORD=
SESSION_SECRET=finance-manager-dev-secret
SESSION_HOURS=168

# Email (SMTP) — optional, for sending invoices and notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=noreply@financemanager.local
EMAIL_FROM_NAME=Finance Manager

# Gig Radar — optional credentials that unlock better (freelance) sources:
#
#   Reddit app-only OAuth — create a free "script" app at
#   https://www.reddit.com/prefs/apps (-> create app -> script), then fill:
#     RADAR_REDDIT_CLIENT_ID=<the id under the app name>
#     RADAR_REDDIT_CLIENT_SECRET=<the secret>
#   Fixes the 403 the anonymous endpoints hit; surfaces r/forhire freelancer gigs.
#
#   Freelancer.com API key — from your Freelancer account
#   (Settings -> API -> API key). Surfaces real one-off freelance projects
#   with budgets. Without it that source stays off.
RADAR_REDDIT_CLIENT_ID=
RADAR_REDDIT_CLIENT_SECRET=
RADAR_FREELANCER_API_KEY=